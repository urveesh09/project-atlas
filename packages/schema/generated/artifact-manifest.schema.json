    "schemaVersion": {
      "type": "string",
      "const": "atlas.graph/1.0.0"
    },
    "analysisId": {
      "type": "string",
      "pattern": "^analysis_[0-9a-f]{64}$"
    },
    "analysisKey": {
      "type": "string",
      "pattern": "^akey_[0-9a-f]{64}$"
    },
    "repo": {
      "type": "object",
      "properties": {
        "repoId": {
          "type": "string",
          "pattern": "^repo_[0-9a-f]{64}$"
        },
        "displayName": {
          "type": "string"
        },
        "sourceKind": {
          "type": "string",
          "enum": [
            "local-git",
            "public-github"
          ]
        },
        "remote": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "host": {
                  "type": "string",
                  "const": "github.com"
                },
                "owner": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"
                },
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]{1,100}$"
                },
                "numericId": {
                  "type": "string",
                  "pattern": "^[1-9]\\d{0,19}$"
                }
              },
              "required": [
                "host",
                "owner",
                "name",
                "numericId"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "objectFormat": {
          "type": "string",
          "enum": [
            "sha1",
            "sha256"
          ]
        }
      },
      "required": [
        "repoId",
        "displayName",
        "sourceKind",
        "remote",
        "objectFormat"
      ],
      "additionalProperties": false
