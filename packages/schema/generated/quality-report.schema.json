{
  "$id": "https://atlas.invalid/schemas/quality-report.schema.json",
  "title": "ATLAS quality-report (atlas.quality/1)",
  "$comment": "Generated from @atlas/schema. Runtime validators additionally enforce ordering, references, coverage arithmetic and geometry invariants.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "atlas.quality/1"
    },
    "analysisId": {
      "type": "string",
      "pattern": "^analysis_[0-9a-f]{64}$"
    },
    "repoId": {
      "type": "string",
      "pattern": "^repo_[0-9a-f]{64}$"
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^snap_[0-9a-f]{64}$"
    },
    "commitOid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "binding": {
      "type": "string",
      "const": "user-declared"
    },
    "scanScope": {
      "type": "string",
      "const": "unverified"
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "const": "ruff"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d{1,4}\\.\\d{1,4}\\.\\d{1,4}$"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "inputResults": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20000
    },
    "dropped": {
      "type": "object",
      "properties": {
        "unmapped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20000
        },
        "unsupported": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20000
        },
        "suppressed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20000
        },
        "duplicates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20000
        }
      },
      "required": [
        "unmapped",
        "unsupported",
        "suppressed",
        "duplicates"
      ],
      "additionalProperties": false
    },
    "findings": {
      "maxItems": 4096,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^qf_[0-9a-f]{64}$"
          },
          "nodeId": {
            "type": "string",
            "pattern": "^node_[0-9a-f]{64}$"
          },
          "lineageId": {
            "type": "string",
            "pattern": "^lin_[0-9a-f]{64}$"
          },
          "path": {
            "type": "string"
          },
          "blobOid": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "ruleId": {
            "type": "string",
            "pattern": "^[A-Z]{1,5}[0-9]{3,4}$"
          },
          "level": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "note"
            ]
          },
          "line": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000000
          },
          "column": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "nodeId",
          "lineageId",
          "path",
          "blobOid",
          "ruleId",
          "level",
          "line",
          "column"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "analysisId",
    "repoId",
    "snapshotId",
    "commitOid",
    "binding",
    "scanScope",
    "tool",
    "inputResults",
    "dropped",
    "findings"
  ],
  "additionalProperties": false
}
