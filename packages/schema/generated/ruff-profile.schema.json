{
  "$id": "https://atlas.invalid/schemas/ruff-profile.schema.json",
  "title": "ATLAS ruff-profile (atlas.ruff-profile/1)",
  "$comment": "Generated from @atlas/schema. Runtime validators additionally enforce ordering, references, coverage arithmetic and geometry invariants.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "atlas.ruff-profile/1"
    },
    "isolated": {
      "type": "boolean",
      "const": true
    },
    "ignoreNoqa": {
      "type": "boolean",
      "const": true
    },
    "respectGitignore": {
      "type": "boolean",
      "const": false
    },
    "forceExclude": {
      "type": "boolean",
      "const": false
    },
    "targetVersion": {
      "type": "string",
      "pattern": "^py3(?:[89]|1[0-5])$"
    },
    "rules": {
      "minItems": 1,
      "maxItems": 1024,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{1,5}[0-9]{3,4}$"
      }
    }
  },
  "required": [
    "format",
    "isolated",
    "ignoreNoqa",
    "respectGitignore",
    "forceExclude",
    "targetVersion",
    "rules"
  ],
  "additionalProperties": false
}
