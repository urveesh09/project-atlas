# Root-owned /etc/atlas/worker.env, mode 0644; no secrets here.
# Never add ATLAS_DEVELOPMENT, fixture acquisition, or process isolation.
ATLAS_STORAGE=s3
ATLAS_S3_ENDPOINT=https://storage.example.org
ATLAS_S3_REGION=us-east-1
ATLAS_S3_BUCKET=atlas-artifacts
ATLAS_SANDBOX_IMAGE=sha256:REPLACE_WITH_BUILT_IMMUTABLE_IMAGE_ID
ATLAS_WORKER_SLOTS=1
