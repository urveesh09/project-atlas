#!/usr/sbin/nft -f
# DEDICATED Linux worker only. Replace documentation addresses before installing.
# Additive to Docker's firewall; never flush the ruleset or edit Docker-owned tables.
define resolver4 = 192.0.2.53
define database4 = 192.0.2.10
define storage4 = 192.0.2.20
define broker_subnet = 172.28.0.0/24
define acquisition_pool = 172.29.0.0/16

destroy table inet atlas_egress
table inet atlas_egress {
    # Published API bootstrap ranges, checked 2026-10-18; expire in 15 minutes.
    # The service must refresh successfully before starting the coordinator.
    set github4 {
        type ipv4_addr; flags interval,timeout; timeout 24h;
        elements = { 192.30.252.0/22 timeout 15m,
                     185.199.108.0/22 timeout 15m,
                     140.82.112.0/20 timeout 15m,
                     143.55.64.0/20 timeout 15m,
                     20.201.28.148/32 timeout 15m,
                     20.205.243.168/32 timeout 15m,
                     20.87.245.6/32 timeout 15m,
                     4.237.22.34/32 timeout 15m,
                     4.228.31.149/32 timeout 15m,
                     20.207.73.85/32 timeout 15m,
                     20.27.177.116/32 timeout 15m,
                     20.200.245.245/32 timeout 15m,
                     20.175.192.149/32 timeout 15m,
                     20.233.83.146/32 timeout 15m,
                     20.29.134.17/32 timeout 15m,
                     20.199.39.228/32 timeout 15m,
                     20.217.135.0/32 timeout 15m,
                     4.225.11.201/32 timeout 15m,
                     4.208.26.200/32 timeout 15m,
                     20.26.156.210/32 timeout 15m,
                     172.182.252.137/32 timeout 15m,
                     4.249.131.166/32 timeout 15m,
                     48.202.248.39/32 timeout 15m,
                     48.204.201.2/32 timeout 15m }
    }
    set github6 {
        type ipv6_addr; flags interval,timeout; timeout 24h;
        elements = { 2a0a:a440::/29 timeout 15m, 2606:50c0::/32 timeout 15m }
    }
    chain input {
        type filter hook input priority -10; policy accept;
        ct state established,related accept
        # Containers must not reach a host service as an alternate egress proxy.
        iifname "docker0" counter drop
        ip saddr $acquisition_pool counter drop
    }
    chain output {
        type filter hook output priority -10; policy drop;
        oifname "lo" accept
        ct state established,related accept
        # Docker's DNS forwarder runs on the host. Permit only the fixed resolver.
        ip daddr $resolver4 udp dport 53 accept
        ip daddr $resolver4 tcp dport 53 accept
        # Coordinator visibility checks; root refresh service downloads /meta only.
        meta skuid { 0, 10001 } ip daddr @github4 tcp dport 443 accept
        meta skuid { 0, 10001 } ip6 daddr @github6 tcp dport 443 accept
        meta skuid 10001 ip daddr $database4 tcp dport 5432 accept
        meta skuid 10001 ip daddr $storage4 tcp dport 443 accept
        counter drop
    }
    chain forward {
        type filter hook forward priority -10; policy drop;
        ct state established,related accept
        # Per-job bridge traffic still passes Docker's own network isolation rules.
        ip saddr $acquisition_pool ip daddr $acquisition_pool tcp dport 3128 accept
        # Only brokers join docker0. No other service/container belongs on this host.
        iifname "docker0" ip saddr $broker_subnet ip daddr @github4 tcp dport 443 accept
        iifname "docker0" ip saddr $broker_subnet ip daddr $resolver4 udp dport 53 accept
        iifname "docker0" ip saddr $broker_subnet ip daddr $resolver4 tcp dport 53 accept
        counter drop
    }
}
