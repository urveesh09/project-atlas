[Unit]
Description=Prune expired ATLAS backup files

[Service]
Type=oneshot
User=10002
Group=10002
Environment=ATLAS_BACKUP_DIR=/var/lib/atlas/backups
ExecStart=/opt/atlas/node/bin/node /opt/atlas/production/backup.mjs --prune
StateDirectory=atlas/backups
StateDirectoryMode=0700
ReadWritePaths=/var/lib/atlas/backups
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
