[Unit]
Description=ATLAS isolated analysis coordinator (one per dedicated Docker engine)
Requires=docker.service atlas-egress.service atlas-egress-refresh.service
After=docker.service network-online.target atlas-egress.service atlas-egress-refresh.service
Wants=network-online.target

[Service]
Type=simple
User=10001
Group=10001
# Docker control is root-equivalent: this host must be dedicated to ATLAS.
SupplementaryGroups=docker
WorkingDirectory=/opt/atlas/current
EnvironmentFile=/etc/atlas/worker.env
LoadCredential=database_url:/etc/atlas/secrets/worker_database_url
LoadCredential=storage_access_key:/etc/atlas/secrets/worker_storage_access_key
LoadCredential=storage_secret:/etc/atlas/secrets/worker_storage_secret
Environment=ATLAS_DATABASE_URL_FILE=%d/database_url
Environment=ATLAS_S3_ACCESS_KEY_ID_FILE=%d/storage_access_key
Environment=ATLAS_S3_SECRET_ACCESS_KEY_FILE=%d/storage_secret
Environment=ATLAS_WORK_ROOT=/var/lib/atlas/jobs
Environment=HOME=/var/lib/atlas
Environment=ATLAS_DOCKER_EXECUTABLE=/usr/bin/docker
ExecStart=/opt/atlas/node/bin/node /opt/atlas/current/dist/bin.js
Restart=on-failure
RestartSec=5s
# Attempts have a 300 s deadline, but stop also awaits bounded maintenance batches.
# Those have per-operation deadlines, not a batch-wide bound. Never guess a total
# and kill a draining coordinator; the crash/reaper runbook covers forced recovery.
TimeoutStopSec=infinity
KillMode=control-group
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/atlas/jobs
UMask=0077

[Install]
WantedBy=multi-user.target
