# Copy outside the checkout. No secrets in this file; never commit the completed file.
ATLAS_DOMAIN=atlas.example.org
ATLAS_PUBLIC_ORIGIN=https://atlas.example.org
ATLAS_API_IMAGE=sha256:REPLACE_WITH_BUILT_IMMUTABLE_IMAGE_ID
ATLAS_PROXY_IMAGE=sha256:REPLACE_WITH_BUILT_PROXY_IMAGE_ID
ATLAS_SECRET_DIR=/etc/atlas/secrets
ATLAS_S3_ENDPOINT=https://storage.example.org
ATLAS_S3_BUCKET=atlas-artifacts
ATLAS_S3_REGION=us-east-1
